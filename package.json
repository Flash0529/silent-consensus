{
  "name": "quiet-consensus",
  "version": "0.1.0",
  "private": true,
  "description": "Plans everyone can say yes to.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e:hangout": "node tests/e2e/hangout.mjs",
    "test:e2e:mediation": "node tests/e2e/mediation.mjs",
    "test:e2e:remember": "node tests/e2e/remember.mjs",
    "test:e2e": "npm run test:e2e:remember && npm run test:e2e:hangout && npm run test:e2e:mediation"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.4.4",
    "ical.js": "^2.2.1",
    "nanoid": "^6.0.1",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
