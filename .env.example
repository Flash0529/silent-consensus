DATABASE_URL=
# Same as DATABASE_URL without -pooler (used for schema pushes)
DIRECT_URL=
APP_URL=http://localhost:3000
DEMO_MODE=true
COOKIE_SECRET=

# Meta Model API (primary)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_STT_MODEL=muse-voice-transcribe-1.0
# Reasoning effort sent to Meta (minimal is the only level that reliably returns content today)
META_REASONING=minimal

# SpaceXAI / Grok (fallback; HackGT gives every hacker Grok credits)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_STT_MODEL=grok-voice-transcribe-2.0

# OpenRouter / TypeSafe Jev (second fallback, and dev default until Meta/xAI keys arrive)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=typesafe/jev-router
# Provider order for callLLM (comma-separated; providers without a key are skipped)
LLM_PROVIDERS=meta,xai,openrouter
