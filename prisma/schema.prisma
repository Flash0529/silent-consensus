generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CircleKind {
  PLAN
  MEDIATE
}

enum CircleStatus {
  COLLECTING
  PLANNING
  PROPOSED
  CONFIRMED
  PAUSED
}

enum PlanningStage {
  NONE
  READING
  FILTERING
  COMPOSING
  MAPPING
  DRAFTING
  BALANCING
  CHECKING
  DONE
  FAILED
}

enum Role {
  ORGANIZER
  MEMBER
}

enum InterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum MsgRole {
  HUSH
  MEMBER
}

enum MsgKind {
  TEXT
  OPTIONS
  VOICE
  CONFIRM
  CHIPIN
  FOLLOWUP
}

enum VoteChoice {
  IN
  DIFFERENT_TIME
  TWEAK
  NOT_READY
}

enum GistConsent {
  PENDING
  SHARE
  PRIVATE
}

enum Safety {
  NONE
  CONCERN
  STOP
}

model Circle {
  id            String        @id @default(cuid())
  slug          String        @unique
  kind          CircleKind    @default(PLAN)
  title         String
  topic         String?
  activity      String
  area          String
  windowStart   DateTime
  windowEnd     DateTime
  status        CircleStatus  @default(COLLECTING)
  planningStage PlanningStage @default(NONE)
  replanCount   Int           @default(0)
  foundCount    Int?
  organizerId   String?       @unique
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  members       Member[]
  plans         Plan[]
  traces        AiTrace[]
}

model Member {
  id              String          @id @default(cuid())
  circleId        String
  circle          Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  name            String
  avatarColor     String
  tokenHash       String          @unique
  role            Role            @default(MEMBER)
  interviewStatus InterviewStatus @default(NOT_STARTED)
  persona         String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  messages        Message[]
  vault           Vault?
  perspective     Perspective?
  shares          MemberShare[]
  votes           Vote[]

  @@index([circleId])
}

model Message {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       MsgRole
  kind       MsgKind  @default(TEXT)
  content    String
  options    Json?
  chips      Json?
  topic      String?
  transcript String?
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
}

model Vault {
  memberId         String   @id
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  budgetCapCents   Int?
  dietary          String[]
  alcohol          String?
  stepFreeRequired Boolean?
  availableWindows Json?
  noise            String?
  vibe             String[]
  maxTravelMinutes Int?
  privateNote      String?
  updatedAt        DateTime @updatedAt
}

// Private to one member (mediation mode). Only the consented gist, needs, hopes,
// offers and offLimits may enter the mediator; story and feelings never do.
model Perspective {
  memberId    String      @id
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gist        String?
  gistConsent GistConsent @default(PENDING)
  story       String?
  feelings    String[]
  needs       String[]
  hopes       String[]
  offers      String[]
  offLimits   String[]
  safety      Safety      @default(NONE)
  updatedAt   DateTime    @updatedAt
}

model Plan {
  id              String        @id @default(cuid())
  circleId        String
  circle          Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  kind            CircleKind    @default(PLAN)
  version         Int
  title           String
  dateLabel       String
  stops           Json          @default("[]")
  content         Json?
  perPersonCents  Int           @default(0)
  whyItWorks      String[]
  leakCheckPassed Boolean
  status          String        @default("PROPOSED")
  createdAt       DateTime      @default(now())
  shares          MemberShare[]
  chipIns         ChipIn[]
  votes           Vote[]

  @@unique([circleId, version])
}

model MemberShare {
  id             String @id @default(cuid())
  planId         String
  plan           Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  baseCents      Int    @default(0)
  capCents       Int?
  shortfallCents Int    @default(0)
  headroomCents  Int?
  coveredCents   Int    @default(0)
  chipInCents    Int    @default(0)
  refundCents    Int    @default(0)
  finalCents     Int    @default(0)
  privateNote    String @default("")
  brief          Json?

  @@unique([planId, memberId])
}

model ChipIn {
  id           String   @id @default(cuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromMemberId String
  amountCents  Int
  createdAt    DateTime @default(now())

  @@unique([planId, fromMemberId])
}

model Vote {
  id       String     @id @default(cuid())
  planId   String
  plan     Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  memberId String
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  choice   VoteChoice

  @@unique([planId, memberId])
}

model AiTrace {
  id        String   @id @default(cuid())
  circleId  String?
  circle    Circle?  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  task      String
  provider  String
  ms        Int
  ok        Boolean
  label     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([circleId, createdAt])
}
